---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { education, experiences, siteProfile, skills } from "@/lib/site-content";

const skillGroups = {
  Languages: skills.filter((s) => s.category === "core"),
  Frameworks: skills.filter((s) => s.category === "framework"),
  Domains: skills.filter((s) => s.category === "domain"),
};

function formatPeriod(start: string, end: string | null): string {
  const fmt = (d: string) => {
    const [y, m] = d.split("-");
    return `${new Date(Number(y), Number(m) - 1).toLocaleString("default", { month: "short" })} ${y}`;
  };
  return `${fmt(start)} – ${end ? fmt(end) : "Now"}`;
}
---

<BaseLayout
  title="About — Hein Htet Aung"
  description={siteProfile.heroIntro}
>
  <div class="max-w-5xl mx-auto px-6 pt-28 pb-20">

    <section class="mb-20 reveal">
      <span class="section-label">About</span>
      <h1 class="section-heading mb-8">A bit more context</h1>
      {siteProfile.aboutBio.split("\n\n").map((para) => (
        <p class="text-[1.05rem] text-ink-soft leading-relaxed mb-5 max-w-2xl">{para}</p>
      ))}
    </section>

    <section class="mb-20 reveal">
      <span class="section-label">Skills</span>
      <h2 class="section-heading mb-10">What I reach for</h2>
      <div class="grid sm:grid-cols-3 gap-10">
        {Object.entries(skillGroups).map(([label, items]) => (
          <div>
            <h3 class="text-xs font-mono text-faint uppercase tracking-widest mb-4">{label}</h3>
            <ul class="space-y-2.5" role="list">
              {items.map((s) => (
                <li class="text-[0.975rem] text-ink-soft">{s.name}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-20 reveal">
      <span class="section-label">Experience</span>
      <h2 class="section-heading mb-10">Where I’ve worked</h2>
      <div class="divide-y divide-line">
        {experiences.map((exp) => (
          <article class="py-9">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
              <div>
                <h3 class="font-semibold text-ink text-[1.05rem]">{exp.company}</h3>
                <p class="text-[0.975rem] text-muted mt-0.5">{exp.role} · {exp.location}</p>
              </div>
              <p class="text-xs text-faint font-mono shrink-0">{formatPeriod(exp.periodStart, exp.periodEnd)}</p>
            </div>
            <ul class="space-y-2 max-w-2xl">
              {exp.highlights.map((h) => (
                <li class="text-[0.975rem] text-muted flex gap-3 leading-relaxed">
                  <span class="text-accent mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="reveal">
      <span class="section-label">Education</span>
      <h2 class="section-heading mb-10">School</h2>
      <div class="divide-y divide-line">
        {education.map((edu) => (
          <div class="py-8">
            <p class="text-xs text-faint font-mono mb-2">
              {edu.periodStart.split("-")[0]} – {edu.periodEnd ? edu.periodEnd.split("-")[0] : "Now"}
            </p>
            <h3 class="font-semibold text-ink">{edu.degree} — {edu.field}</h3>
            <p class="text-[0.975rem] text-muted mt-1 mb-3">{edu.institution}</p>
            {edu.achievements.length > 0 && (
              <ul class="space-y-2">
                {edu.achievements.map((a) => (
                  <li class="text-[0.975rem] text-muted flex gap-3">
                    <span class="mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
                    <span>{a}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
