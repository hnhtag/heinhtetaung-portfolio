---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  education,
  experiences,
  projects,
  siteProfile,
  siteSettings,
  skills,
} from "@/lib/site-content";

const skillGroups: Record<string, typeof skills> = {
  Languages:  skills.filter((s) => s.category === "core"),
  Frameworks: skills.filter((s) => s.category === "framework"),
  Domains:    skills.filter((s) => s.category === "domain"),
};

function fmt(d: string): string {
  const [y, m] = d.split("-");
  return `${new Date(Number(y), Number(m) - 1).toLocaleString("en", { month: "short" })} ${y}`;
}
function period(start: string, end: string | null): string {
  return `${fmt(start)} – ${end ? fmt(end) : "Now"}`;
}

const featuredProjects = projects.filter((p) => p.featured);
---

<BaseLayout
  title="Hein Htet Aung — Senior Full Stack Software Engineer"
  description={siteProfile.heroIntro}
>

  <!-- Hero: one composition — brand, headline, support, CTAs, portrait -->
  <section
    id="hero"
    class="relative min-h-[100svh] flex items-end md:items-center px-6 pt-24 pb-12 md:pb-20 overflow-hidden"
    aria-label="Introduction"
  >
    <div class="relative max-w-5xl mx-auto w-full grid md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] gap-10 md:gap-8 items-end md:items-center">
      <div class="order-2 md:order-1 pb-2">
        <h1 class="brand-name motion-rise motion-rise-delay-1 mb-6">
          {siteProfile.displayName}
        </h1>

        <p class="motion-rise motion-rise-delay-2 text-xl md:text-[1.65rem] font-display italic text-ink-soft leading-snug max-w-xl mb-5">
          {siteProfile.tagline}
        </p>

        <p class="motion-rise motion-rise-delay-3 text-[0.975rem] text-muted leading-relaxed max-w-md mb-8">
          {siteProfile.heroIntro}
        </p>

        <div class="motion-rise motion-rise-delay-4 flex items-center gap-3 flex-wrap">
          <a href="#work" class="btn-primary">See the work</a>
          <a href="#contact" class="btn-ghost">Say hello</a>
          {siteSettings.cvUrl && (
            <a href={siteSettings.cvUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost">
              CV
            </a>
          )}
        </div>
      </div>

      <div class="order-1 md:order-2 motion-fade flex justify-center md:justify-end self-center">
        {siteSettings.profileImageUrl ? (
          <img
            src={siteSettings.profileImageUrl}
            alt={`Portrait of ${siteProfile.fullName}`}
            width="480"
            height="480"
            loading="eager"
            fetchpriority="high"
            class="w-[min(78vw,22rem)] md:w-[min(38vw,26rem)] h-auto select-none"
          />
        ) : (
          <div class="w-64 h-64 rounded-full bg-accent-soft" aria-hidden="true"></div>
        )}
      </div>
    </div>
  </section>

  <!-- Work -->
  <section id="work" class="max-w-5xl mx-auto px-6 py-24 md:py-28 reveal" aria-labelledby="work-heading">
    <span class="section-label">Selected work</span>
    <h2 id="work-heading" class="display-heading mb-4">Things I’ve shipped</h2>
    <p class="text-muted max-w-xl mb-12">
      Enterprise platforms and operational tools — less portfolio gloss, more systems people use.
    </p>

    <div class="divide-y divide-line">
      {featuredProjects.map((p, i) => (
        <article class="flex gap-5 sm:gap-7 py-9 group" aria-label={p.title}>
          <span class="work-num">{String(i + 1).padStart(2, "0")}</span>
          <div class="flex-1 min-w-0">
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2 mb-2.5">
              <h3 class="font-semibold text-ink text-[1.05rem] leading-snug group-hover:text-accent transition-colors">
                {p.title}
              </h3>
              <p class="text-xs text-faint font-mono shrink-0">
                {p.tags.join(" · ")}
              </p>
            </div>
            <p class="text-[0.975rem] text-muted leading-relaxed max-w-2xl">
              {p.summary}
            </p>
            {(p.githubUrl || p.liveUrl) && (
              <div class="flex gap-5 mt-3">
                {p.githubUrl && (
                  <a href={p.githubUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-link">
                    GitHub
                  </a>
                )}
                {p.liveUrl && (
                  <a href={p.liveUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-link">
                    Live site
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section
    id="experience"
    class="max-w-5xl mx-auto px-6 py-24 md:py-28 border-t border-line reveal"
    aria-labelledby="exp-heading"
  >
    <span class="section-label">Experience</span>
    <h2 id="exp-heading" class="display-heading mb-12">Where I’ve worked</h2>

    <div class="divide-y divide-line">
      {experiences.map((exp) => (
        <article class="py-9" aria-label={`${exp.role} at ${exp.company}`}>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-3">
            <div>
              <h3 class="font-semibold text-ink text-[1.05rem]">{exp.company}</h3>
              <p class="text-[0.975rem] text-muted mt-0.5">{exp.role}</p>
            </div>
            <p class="text-xs text-faint font-mono mt-1 sm:mt-0 shrink-0">
              {period(exp.periodStart, exp.periodEnd)}
            </p>
          </div>
          <ul class="space-y-2 max-w-2xl">
            {exp.highlights.slice(0, 3).map((h) => (
              <li class="text-[0.975rem] text-muted flex gap-3 leading-relaxed">
                <span class="text-accent mt-2 shrink-0 w-1.5 h-1.5 rounded-full bg-accent/70" aria-hidden="true"></span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <!-- Skills -->
  <section
    id="skills"
    class="max-w-5xl mx-auto px-6 py-24 md:py-28 border-t border-line reveal"
    aria-labelledby="skills-heading"
  >
    <span class="section-label">Skills</span>
    <h2 id="skills-heading" class="display-heading mb-12">What I reach for</h2>

    <div class="grid sm:grid-cols-3 gap-10">
      {Object.entries(skillGroups).filter(([, items]) => items.length > 0).map(([label, items]) => (
        <div>
          <h3 class="text-xs font-mono text-faint uppercase tracking-widest mb-4">{label}</h3>
          <ul class="space-y-2.5" role="list">
            {items.map((s) => (
              <li class="text-[0.975rem] text-ink-soft">{s.name}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- About -->
  <section
    id="about"
    class="max-w-5xl mx-auto px-6 py-24 md:py-28 border-t border-line reveal"
    aria-labelledby="about-heading"
  >
    <span class="section-label">About</span>
    <h2 id="about-heading" class="display-heading mb-10">A bit more context</h2>

    <div class="max-w-2xl space-y-5">
      {siteProfile.aboutBio.split("\n\n").map((para) => (
        <p class="text-[1.05rem] text-ink-soft leading-relaxed">{para}</p>
      ))}

      {siteSettings.cvUrl && (
        <p class="pt-1">
          <a href={siteSettings.cvUrl} target="_blank" rel="noopener noreferrer" class="text-link text-[0.975rem]">
            Download full CV (PDF)
          </a>
        </p>
      )}

      {education.length > 0 && (
        <div class="pt-8 mt-2 border-t border-line space-y-5">
          <h3 class="text-xs font-mono text-faint uppercase tracking-widest">Education</h3>
          {education.map((edu) => (
            <div>
              <p class="text-[0.975rem] text-ink font-medium">{edu.institution}</p>
              <p class="text-sm text-muted mt-0.5">
                {edu.degree} · {edu.field} · {edu.periodStart.slice(0, 4)}–{edu.periodEnd?.slice(0, 4) ?? "Now"}
              </p>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Contact -->
  <section
    id="contact"
    class="max-w-5xl mx-auto px-6 py-24 md:py-28 border-t border-line reveal"
    aria-labelledby="contact-heading"
  >
    <span class="section-label">Contact</span>
    <h2 id="contact-heading" class="display-heading mb-4">Say hello</h2>
    <p class="text-muted mb-10 max-w-md">
      Have a product problem, a team that needs another steady hand, or just want to compare notes? I usually reply within a couple of days.
    </p>

    <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
      {siteProfile.linkedinUrl && (
        <a
          href={siteProfile.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          LinkedIn
        </a>
      )}
      <a href="#work" class="text-link text-[0.975rem]">Or browse the work first</a>
    </div>
  </section>

</BaseLayout>
