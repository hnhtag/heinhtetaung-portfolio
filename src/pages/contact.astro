---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteProfile } from "@/lib/site-content";
---

<BaseLayout
  title="Contact — Hein Htet Aung"
  description="Get in touch with Hein Htet Aung."
>
  <div class="max-w-5xl mx-auto px-6 pt-28 pb-20">
    <div class="reveal max-w-xl">
      <span class="section-label">Contact</span>
      <h1 class="section-heading mb-4">Say hello</h1>
      <p class="text-muted mb-10">
        Have a product problem, a team that needs another steady hand, or just want to compare notes? I usually reply within a couple of days.
      </p>

      <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
        {siteProfile.linkedinUrl && (
          <a
            href={siteProfile.linkedinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            LinkedIn
          </a>
        )}
        <a href="/#work" class="text-link text-[0.975rem]">Or browse the work first</a>
      </div>
    </div>
  </div>
</BaseLayout>
